# =============================================================================
# SparkFeed — Environment Variables
# Copy this file to .env.local and fill in your values.
# Only DATABASE_URL + BETTER_AUTH_SECRET are required to boot.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Works with: Railway, Supabase, Neon, Render, Docker, any VPS with PostgreSQL.
# Format: postgresql://user:password@host:5432/database
# Local dev: install PostgreSQL and create a database, or use Docker:
#   docker run -d -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
# Migrations do NOT run on server start. Apply them deliberately:
#   bun run db:migrate
# On a database first created with `db:push`, the migration journal is empty and
# a plain migrate would try to re-run 0000's CREATE TABLEs. Baseline it once:
#   bun run db:baseline            (dry run)
#   bun run db:baseline -- --apply
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sparkfeed

# The one-file Docker Compose setup uses this password for its internal
# PostgreSQL service. Generate a hex value to avoid URL-encoding problems:
#   openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-hex-string
# Change the host port when port 3000 is already in use.
SPARKFEED_PORT=3000

# -----------------------------------------------------------------------------
# Auth (better-auth)
# Generate a secret: openssl rand -base64 32
# APP_URL is used in email links (invites, password resets, verification).
# VITE_AUTH_URL is the client-side base for auth API calls — leave unset
# to auto-detect from window.location.origin (recommended for most deployments).
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-a-long-random-string
#
# APP_URL and BETTER_AUTH_URL must include the scheme. On Railway, note that
# ${{RAILWAY_PUBLIC_DOMAIN}} expands to a bare hostname with no https://, so
# set these as https://${{RAILWAY_PUBLIC_DOMAIN}} or every emailed link comes
# out relative and unclickable.
APP_URL=http://localhost:3000
# BETTER_AUTH_URL — the origin better-auth builds verification links from.
# Leave unset locally; set it in any deployment or verification emails point
# at localhost.
# BETTER_AUTH_URL=http://localhost:3000
# VITE_AUTH_URL=http://localhost:3000   # Only needed for split-domain setups

# -----------------------------------------------------------------------------
# Registration control
# ALLOW_REGISTRATION=true  -> anyone can sign up
# ALLOW_REGISTRATION=false -> invite-only after the first user registers (default)
# A valid invitation can create an account while registration is closed.
# -----------------------------------------------------------------------------
ALLOW_REGISTRATION=false

# Workspace creation is independent from registration:
# owner-only -> only the first registered account can create workspaces (default)
# all-users  -> every registered account can create workspaces
WORKSPACE_CREATION_POLICY=owner-only

# -----------------------------------------------------------------------------
# Edition and hosted billing
# Community is the safe default and does not read or call Dodo Payments.
# Sparkfeed Cloud requires every Dodo setting below at server startup.
# Product IDs are identifiers, but the browser must never choose them directly.
# -----------------------------------------------------------------------------
SPARKFEED_EDITION=community
SPARKFEED_SURFACE=app

# Cloud services use different origins and host-only cookie prefixes. Set only
# the origin for the service being deployed; never set a parent cookie domain.
# SPARKFEED_APP_ORIGIN=https://app.sparkfeed.dev
# SPARKFEED_ADMIN_ORIGIN=https://admin.sparkfeed.dev
# One-time admin bootstrap: set this only on the admin service to the exact
# verified email of an existing account, sign in once, then remove it.
# SPARKFEED_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# For the isolated admin service, set SPARKFEED_SURFACE=admin,
# BETTER_AUTH_URL to the admin origin, leave VITE_AUTH_URL unset (or set it to
# that same admin origin), set APP_URL and SPARKFEED_APP_ORIGIN to the customer
# app origin, and reuse DATABASE_URL, BETTER_AUTH_SECRET, email settings, and
# the Dodo test API key/product IDs from the app service. The webhook secret is
# app-only and should not be copied to the admin service.

# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_API_KEY=
# The signing secret belongs to one webhook endpoint. A localhost Dodo CLI
# relay, beta.sparkfeed.dev, and the production app each use different values.
# Never copy the CLI relay secret into Railway.
# DODO_PAYMENTS_WEBHOOK_SECRET=
# DODO_PERSONAL_MONTHLY_PRODUCT_ID=
# DODO_PERSONAL_ANNUAL_PRODUCT_ID=

# -----------------------------------------------------------------------------
# AI Provider — set at least one of the three below.
# Priority order: OpenAI → Vercel AI SDK Gateway → OpenRouter
#
# The order is per-model, not global: Spark AI picks the highest-priority
# provider that BOTH has a key here AND actually serves the chosen model. Claude
# and Gemini have no OpenAI route, so they fall through to the gateway or
# OpenRouter even when OPENAI_API_KEY is set. See src/config/ai-models.json.
#
# Set DISABLE_AI=true to lock the Spark AI tab for all users (free tier limit).
# Optional: AI_DEFAULT_MODEL overrides the starting model. It must be an `id`
# from ai-models.json — anything else is ignored with a warning, since the
# catalogue doubles as the server-side allowlist. (Replaces the old AI_MODEL,
# which accepted any string and so bypassed that allowlist.)
# -----------------------------------------------------------------------------
DISABLE_AI=false
# AI_DEFAULT_MODEL=gpt-5.6-luna

# Option 1 — OpenAI (recommended for most users)
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Option 2 — Vercel AI SDK Gateway (best for developers / Vercel users)
# https://vercel.com/docs/ai/ai-gateway
# AI_GATEWAY_API_KEY=...

# Option 3 — OpenRouter (access to 200+ models from one key)
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# -----------------------------------------------------------------------------
# Email — pick ONE of the two options below.
# Priority order: Resend → SMTP
# EMAIL_FROM sets the sender address used by both providers.
# If neither is configured, email sending is silently skipped (good for local dev).
# -----------------------------------------------------------------------------
# EMAIL_FROM="SparkFeed <no-reply@sparkfeed.dev>"
# TEAM_REQUEST_TO=hello@sparkable.dev

# Option 1 — Resend (easiest setup, recommended)
# https://resend.com/api-keys
# RESEND_API_KEY=re_...

# Option 2 — Custom SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# SMTP_IGNORE_TLS=false

# -----------------------------------------------------------------------------
# Feature flags (server-side — cannot be bypassed from the client)
# -----------------------------------------------------------------------------
# DISABLE_AI=false                    # Lock Spark AI for all users
# DISABLE_PASSWORD_SHARING=false      # Disable password-protected folder/feed sharing
# FEED_REFRESH_INTERVAL_HOURS=2       # How often to auto-refresh RSS feeds (default: 2)

# -----------------------------------------------------------------------------
# Demo Mode — skips authentication and loads pre-seeded demo data
# Uses an isolated local SQLite file (rss-demo.db) — no DATABASE_URL needed.
# Set to true for showcases, open-source self-hosters, or onboarding demos.
#
# SET BOTH TOGETHER. VITE_ is inlined into the client bundle at build time, which
# makes it useless for server-side gates (it cannot be changed at deploy time,
# and it is a client constant). DEMO_MODE is the runtime twin that server code
# reads — Spark AI's kill switch is one such gate.
# -----------------------------------------------------------------------------
VITE_DEMO_MODE=false
DEMO_MODE=false
