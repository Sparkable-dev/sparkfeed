---
/* Closing call to action. Styles: src/styles/landing.css (── CTA BAND). */
import Icon from './Icon.astro';

interface Props {
	title: string;
	href: string;
	cta: string;
}

const { title, href, cta } = Astro.props;
---

<aside class="sf-cta not-content">
	<p class="sf-cta-title">{title}</p>
	<a class="sf-hero-btn is-primary" href={href}>
		<span>{cta}</span>
		<Icon name="arrow-right" />
	</a>
</aside>
