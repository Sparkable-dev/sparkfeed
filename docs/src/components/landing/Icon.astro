---
/* Stroke-only icon renderer for the landing page. See ./icons.ts for why this
   exists alongside Starlight's own <Icon>. Size is inherited from font-size so
   callers control it from CSS rather than passing a prop. */
import { landingIcons, type LandingIcon } from './icons';

interface Props {
	name: LandingIcon;
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
	class={className}
	aria-hidden="true"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	set:html={landingIcons[name]}
/>

<style>
	svg {
		width: 1em;
		height: 1em;
		flex-shrink: 0;
	}
</style>
