---
/* A whole-card link. Styles: src/styles/landing.css (── NAV CARDS).

   Neither Starlight component does this job: <Card> takes an icon but is an
   <article> with no link, and <LinkCard> is clickable but has no icon prop.
   Rather than combine them and paper over it with the `a::before { inset: 0 }`
   overlay <LinkCard> uses, the anchor here IS the card, so the hit area, the
   hover state and the focus ring are all the same box. */
import Icon from './Icon.astro';
import type { LandingIcon } from './icons';

interface Props {
	href: string;
	title: string;
	description: string;
	icon: LandingIcon;
	external?: boolean;
}

const { href, title, description, icon, external = false } = Astro.props;
---

<a
	class="sf-navcard"
	href={href}
	{...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
	<span class="sf-navcard-icon"><Icon name={icon} /></span>
	<span class="sf-navcard-title">
		{title}
		{external && <Icon name="arrow-up-right" class="sf-navcard-ext" />}
	</span>
	<span class="sf-navcard-desc">{description}</span>
</a>
