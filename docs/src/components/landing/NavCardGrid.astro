---
/* Grid wrapper for <NavCard>. Styles: src/styles/landing.css (── NAV CARDS).

   Not Starlight's <CardGrid>: that component hardcodes `1fr 1fr` above 50rem,
   and the reference layouts are 3-up. */
interface Props {
	cols?: 2 | 3;
}

const { cols = 3 } = Astro.props;
---

<div class="sf-navcard-grid not-content" data-cols={cols}><slot /></div>
